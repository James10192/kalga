# Convex (renseignés par `convex dev` — voir plan 002/003)
VITE_CONVEX_URL=
# Même valeur que VITE_CONVEX_URL mais en .site (pas .cloud) — requis par l'auth SSR
VITE_CONVEX_SITE_URL=

# Proxy WhatsApp serveur (process web TanStack/Nitro — voir plan 010)
# Le proxy /api/wa/* garde le port du bridge INTERNE et signe via X-Internal-Key.
# URL du bridge WhatsApp (dev: http://localhost:3001)
KALGA_WHATSAPP_URL=
# Secret partagé bridge <-> proxy (même valeur que côté bridge). Jamais committé.
INTERNAL_API_KEY=

# Better Auth / Convex (posés côté Convex via `convex env set`, voir plan 003)
# Jamais préfixés VITE_ (secrets serveur), jamais committés.
# BETTER_AUTH_SECRET=        # openssl rand -base64 32
# SITE_URL=                  # URL publique du site (dev: http://localhost:3000)
# KALGA_OTP_SENDER_PHONE=    # session WhatsApp centrale KALGA qui émet les OTP (GATE-2)
