{
  "name": "kalga-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend KALGA — Nuxt 4 + Vue 3 + TypeScript strict (storefront, dashboard marchand, admin)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.4.0",
    "@pinia/nuxt": "0.9.0",
    "nuxt-auth-utils": "0.5.20",
    "@sentry/nuxt": "9.40.0",
    "@tanstack/vue-query": "5.62.7",
    "@vite-pwa/nuxt": "1.0.1",
    "@vueuse/core": "12.5.0",
    "@vueuse/nuxt": "12.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "0.475.0",
    "nuxt": "4.4.6",
    "pinia": "2.3.1",
    "reka-ui": "2.5.0",
    "shadcn-nuxt": "2.2.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "vue": "3.5.13",
    "vue-router": "5.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.10.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "happy-dom": "16.5.3",
    "prettier": "3.4.2",
    "tailwindcss": "4.3.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
