# =============================================================================
# KALGA Frontend — Variables d'environnement
# =============================================================================
# Copier ce fichier en `.env` et remplir les valeurs avant `pnpm dev`.
# Convention : NUXT_PUBLIC_* = exposé au browser, NUXT_* = serveur uniquement.
# Voir ARCHITECTURE_FRONTEND.md section 7.1 (auth) + 5.4 (SSOT).
# =============================================================================

# -----------------------------------------------------------------------------
# Backend FastAPI (kalga-api)
# -----------------------------------------------------------------------------
# URL interne du backend Python. Utilisée uniquement par le proxy server-side
# (/server/api/proxy/[...path].ts). JAMAIS exposée au browser.
NUXT_API_BACKEND_URL=http://localhost:8001

# Clé partagée entre le frontend Nuxt et le backend FastAPI pour authentifier
# les appels proxy server-to-server. À générer aléatoirement (>= 32 chars).
# Exemple : openssl rand -hex 32
NUXT_PROXY_INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Bridge WhatsApp (kalga-whatsapp, Node/Baileys)
# -----------------------------------------------------------------------------
# URL interne du bridge WhatsApp (:3001). Utilisée server-side pour la connexion
# marchand (QR) et l'établissement de session. JAMAIS exposée au browser.
# ⚠️ OBLIGATOIRE pour le flux marchand : si vide, /api/whatsapp/connect|status|session
#    renvoient 500 (« NUXT_WHATSAPP_BRIDGE_URL non configuré »).
NUXT_WHATSAPP_BRIDGE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Sessions / Auth (cookies HttpOnly)
# -----------------------------------------------------------------------------
# Secret de signature des sessions cookies. Doit faire au minimum 32 caractères.
# À générer aléatoirement et NE JAMAIS commiter.
# Exemple : openssl rand -base64 48
# ⚠️ OBLIGATOIRE : si vide, le proxy /api/proxy/* plante en 500 (« Empty password »)
#    et TOUT le frontend reste bloqué en chargement (le serveur refuse de démarrer,
#    cf. server/plugins/validate-env.ts).
NUXT_SESSION_PASSWORD=

# -----------------------------------------------------------------------------
# URL publique de l'API (côté client)
# -----------------------------------------------------------------------------
# Tous les appels client passent par le proxy interne Nuxt — pas d'URL directe
# vers FastAPI exposée au browser.
NUXT_PUBLIC_API_URL=/api/proxy

# -----------------------------------------------------------------------------
# Observabilité — Sentry
# -----------------------------------------------------------------------------
# DSN public Sentry. Laisser vide pour désactiver Sentry en local.
NUXT_PUBLIC_SENTRY_DSN=

# Auth token Sentry pour upload des sourcemaps en CI (jamais en local).
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Environnement
# -----------------------------------------------------------------------------
# development | staging | production
NUXT_PUBLIC_ENVIRONMENT=development
