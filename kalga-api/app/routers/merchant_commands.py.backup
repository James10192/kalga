from fastapi import APIRouter, HTTPException
from ..database import get_db
from pydantic import BaseModel
from typing import Optional, Dict, Set
from datetime import datetime, timedelta
import re
import asyncio

router = APIRouter(prefix="/merchant", tags=["Commandes Marchand"])

# Sessions de création de produit en cours (en mémoire)
# Format: {merchant_phone: {step: str, data: dict, created_at: datetime}}
product_sessions: Dict[str, dict] = {}

# Verrous pour éviter les conditions de course
session_locks: Dict[str, asyncio.Lock] = {}

# Timeout des sessions (10 minutes)
SESSION_TIMEOUT_MINUTES = 10


def get_session_lock(merchant_phone: str) -> asyncio.Lock:
    """Obtient ou crée un verrou pour un marchand"""
    if merchant_phone not in session_locks:
        session_locks[merchant_phone] = asyncio.Lock()
    return session_locks[merchant_phone]


def cleanup_expired_sessions():
    """Nettoie les sessions expirées"""
    now = datetime.now()
    expired = [
        phone for phone, session in product_sessions.items()
        if now - session.get('created_at', now) > timedelta(minutes=SESSION_TIMEOUT_MINUTES)
    ]
    for phone in expired:
        del product_sessions[phone]
        print(f"Session expirée supprimée pour {phone}")


class MerchantMessage(BaseModel):
    """Message du marchand via WhatsApp"""
    merchant_phone: str
    message: str
    image_path: Optional[str] = None  # Chemin de l'image si envoyée


def extract_price(text: str) -> Optional[float]:
    """Extrait un prix d'un message - doit être explicitement un prix"""
    text_lower = text.lower().strip()

    # Pattern pour "15k" ou "15K" (très fiable pour un prix)
    k_match = re.search(r'(\d+)\s*k\b', text_lower)
    if k_match:
        return float(k_match.group(1)) * 1000

    # Pattern pour nombres avec FCFA/F explicite: "15000 fcfa", "15 000 f"
    fcfa_match = re.search(r'(\d[\d\s]*\d|\d+)\s*(?:fcfa|f|francs)\b', text_lower)
    if fcfa_match:
        value = fcfa_match.group(1).replace(' ', '')
        return float(value)

    # Si le message est UNIQUEMENT un nombre (réponse directe à "quel prix?")
    # Ex: "15000" ou "15 000"
    clean_text = text.strip().replace(' ', '')
    if clean_text.isdigit() and len(clean_text) >= 4:
        return float(clean_text)

    # Pattern pour nombres >= 1000 si le message est court (moins de 20 caractères)
    # Évite les faux positifs comme "j'ai 2 enfants"
    if len(text) < 20:
        num_match = re.search(r'\b(\d{4,})\b', text)
        if num_match:
            return float(num_match.group(1))

    return None


@router.post("/command")
async def handle_merchant_command(msg: MerchantMessage):
    """
    Gère les commandes WhatsApp du marchand:
    - "produit" ou "nouveau produit" : Démarre la création d'un produit
    - "mes produits" ou "liste" : Liste les produits du marchand
    - "supprimer #K001" : Désactive un produit
    - "aide" : Affiche l'aide
    """
    print(f"\n[MerchantCommand] Reçu: phone={msg.merchant_phone}, message='{msg.message}', image={msg.image_path}")

    db = await get_db()
    merchant_phone = msg.merchant_phone
    message = msg.message.strip().lower()

    print(f"[MerchantCommand] Message normalisé: '{message}'")

    # Nettoyer les sessions expirées
    cleanup_expired_sessions()

    # Vérifier si le marchand existe
    merchant = await db.get_merchant_by_phone(merchant_phone)
    print(f"[MerchantCommand] Marchand trouvé: {merchant is not None}")
    if not merchant:
        return {
            "response": "Tu n'es pas encore enregistré comme marchand. Connecte-toi d'abord via le dashboard.",
            "action": "error"
        }

    # Vérifier si une session de création est en cours
    print(f"[MerchantCommand] Session active: {merchant_phone in product_sessions}")
    if merchant_phone in product_sessions:
        current_session = product_sessions[merchant_phone]
        print(f"[MerchantCommand] Session step: {current_session.get('step')}")
        # Permettre d'annuler avec certaines commandes
        if message in ['mes produits', 'liste', 'produits', 'aide', 'help', 'menu', '?']:
            del product_sessions[merchant_phone]
            print(f"Session création annulée automatiquement pour {merchant_phone}")
            # Continuer pour traiter la commande normalement
        else:
            print(f"[MerchantCommand] Traitement étape création produit")
            # Utiliser un verrou pour éviter les conditions de course
            lock = get_session_lock(merchant_phone)
            async with lock:
                # Re-vérifier que la session existe toujours après avoir acquis le verrou
                if merchant_phone not in product_sessions:
                    print(f"[MerchantCommand] Session disparue après verrou, message ignoré")
                    return {"response": "", "action": "ignored"}
                return await handle_product_creation_step(merchant_phone, msg.message, msg.image_path, merchant, db)

    # === COMMANDES DE GESTION DES VENTES ===

    # Marquer une vente comme terminée (!ok, !livré, !fait)
    if message in ['!ok', '!livré', '!livre', '!fait', '!done', '!termine', '!terminé']:
        # Chercher la dernière conversation pending_delivery ou pending_pickup pour ce marchand
        pending = await db.get_pending_conversations(merchant['id'])

        if not pending:
            return {
                "response": "Tu n'as pas de vente en attente actuellement.",
                "action": "no_pending"
            }

        # Prendre la plus récente
        conv = pending[0]
        await db.update_conversation(conv['id'], status="completed")

        return {
            "response": f"✅ Vente terminée!\n\n{conv.get('product_name', 'Produit')} vendu à {conv.get('current_offer', 0):,.0f} F\nClient: {conv['client_phone']}",
            "action": "sale_completed"
        }

    # Annuler une vente (!annuler, !cancel)
    if message in ['!annuler', '!cancel', '!annule']:
        pending = await db.get_pending_conversations(merchant['id'])

        if not pending:
            return {
                "response": "Tu n'as pas de vente en attente à annuler.",
                "action": "no_pending"
            }

        conv = pending[0]
        await db.update_conversation(conv['id'], status="abandoned")

        return {
            "response": f"❌ Vente annulée.\n\n{conv.get('product_name', 'Produit')} - Client: {conv['client_phone']}\n\nLe produit est de nouveau disponible.",
            "action": "sale_cancelled"
        }

    # === COMMANDES PRINCIPALES ===

    # Aide
    if message in ['aide', 'help', '?', 'menu']:
        return {
            "response": """📋 *Commandes disponibles:*

*PRODUITS*
• *produit* - Ajouter un nouveau produit
• *variante #K001* - Ajouter une couleur/taille
• *mes produits* - Voir tous tes produits
• *supprimer #K001* - Retirer un produit

*VENTES*
• *!ok* ou *!livré* - Marquer une vente comme terminée
• *!annuler* - Annuler une vente en attente

Pour ajouter un produit, écris *produit* et suis les étapes!""",
            "action": "help"
        }

    # Nouveau produit
    if message in ['produit', 'nouveau', 'nouveau produit', 'ajouter', 'ajouter produit', '/produit']:
        product_sessions[merchant_phone] = {
            "step": "name",
            "data": {"merchant_id": merchant['id']},
            "created_at": datetime.now()
        }
        return {
            "response": "📦 *Création d'un nouveau produit*\n\nÉtape 1/5: Quel est le *nom* du produit?",
            "action": "product_create_start"
        }

    # Ajouter une variante à un produit existant
    variante_match = re.search(r'variante\s+#?(K?\d{3})', message, re.IGNORECASE)
    if variante_match:
        code = f"#K{variante_match.group(1).replace('K', '').replace('k', '')}"
        product = await db.get_product_by_code(code)

        if not product:
            return {"response": f"Produit {code} non trouvé.", "action": "error"}

        if product['merchant_id'] != merchant['id']:
            return {"response": "Ce produit ne t'appartient pas.", "action": "error"}

        # Générer ou récupérer le group_id
        group_id = product.get('group_id')
        if not group_id:
            group_id = await db.generate_group_id()
            # Mettre à jour le produit original avec le group_id
            from ..database.connection import get_connection
            async with get_connection() as conn:
                await conn.execute(
                    "UPDATE products SET group_id = ? WHERE id = ?",
                    (group_id, product['id'])
                )
                await conn.commit()

        product_sessions[merchant_phone] = {
            "step": "variant_name",
            "data": {
                "merchant_id": merchant['id'],
                "group_id": group_id,
                "name": product['name'],
                "price": product['price'],
                "min_price": product['min_price'],
                "description": product.get('description'),
                "is_variant": True,
                "original_code": code
            },
            "created_at": datetime.now()
        }
        return {
            "response": f"📦 *Ajout d'une variante pour {product['name']} ({code})*\n\nQuel est le *nom de cette variante*? (ex: Rouge, Bleu, XL, etc.)",
            "action": "variant_create_start"
        }

    # Liste des produits
    if message in ['mes produits', 'liste', 'produits', 'mes articles', '/liste']:
        products = await db.get_products_by_merchant(merchant['id'])

        if not products:
            return {
                "response": "Tu n'as pas encore de produits. Écris *produit* pour en ajouter un!",
                "action": "list_empty"
            }

        product_list = "\n".join([
            f"• *{p['code']}* - {p['name']} ({p['price']:,.0f} F)"
            for p in products if p['is_available']
        ])

        return {
            "response": f"📦 *Tes produits:*\n\n{product_list}\n\nPour ajouter: écris *produit*",
            "action": "list"
        }

    # Supprimer un produit
    if message.startswith('supprimer') or message.startswith('retirer'):
        code_match = re.search(r'#K\d{3}', message.upper())
        if code_match:
            code = code_match.group(0)
            product = await db.get_product_by_code(code)

            if not product:
                return {"response": f"Produit {code} non trouvé.", "action": "error"}

            if product['merchant_id'] != merchant['id']:
                return {"response": "Ce produit ne t'appartient pas.", "action": "error"}

            # Désactiver le produit
            await db.deactivate_product(code)

            return {
                "response": f"✅ Produit {code} ({product['name']}) supprimé!",
                "action": "delete"
            }
        else:
            return {
                "response": "Indique le code du produit à supprimer.\nExemple: *supprimer #K001*",
                "action": "error"
            }

    # Commande non reconnue
    return {
        "response": "Je n'ai pas compris. Écris *aide* pour voir les commandes disponibles.",
        "action": "unknown"
    }


async def handle_product_creation_step(merchant_phone: str, message: str, image_path: Optional[str], merchant: dict, db):
    """Gère les étapes de création d'un produit"""
    session = product_sessions[merchant_phone]
    step = session["step"]
    data = session["data"]

    print(f"[ProductCreation] Step: {step}, message: '{message[:50] if message else ''}', image_path: {image_path}, data_image: {data.get('image_path')}")

    # Annulation
    if message.lower() in ['annuler', 'cancel', 'stop']:
        del product_sessions[merchant_phone]
        return {
            "response": "❌ Création annulée. Écris *produit* pour recommencer.",
            "action": "cancelled"
        }

    # === ÉTAPES POUR VARIANTES ===

    # Étape variante: nom de la variante
    if step == "variant_name":
        data["variant_name"] = message.strip()
        session["step"] = "variant_image"
        return {
            "response": f"✅ Variante: *{data['variant_name']}*\n\nEnvoie *UNE* photo de cette variante (ou écris *passer* si pas d'image)\n\n⚠️ Une seule image à la fois!",
            "action": "variant_step"
        }

    # Étape variante: image
    if step == "variant_image":
        # Vérifier si la variante a déjà été créée (protection anti-doublon)
        if data.get("variant_created"):
            print(f"[MerchantCommands] Variante déjà créée, message tardif ignoré")
            return {
                "response": "",
                "action": "ignored"
            }

        # Si on a déjà une image dans data ET qu'une nouvelle image arrive,
        # ignorer SEULEMENT si le message est vide (image dupliquée WhatsApp)
        if data.get("image_path") and image_path and not message.strip():
            print(f"[MerchantCommands] Image variante déjà reçue, ignorant l'image supplémentaire")
            return {
                "response": "",
                "action": "ignored"  # Ne pas envoyer de message
            }

        if image_path:
            data["image_path"] = image_path
        elif message.lower() not in ['passer', 'skip', 'non', '-']:
            # Le marchand a envoyé un texte au lieu d'une image
            return {
                "response": "Envoie une *photo* ou écris *passer* pour continuer sans image",
                "action": "error"
            }

        # Marquer que la création est en cours pour éviter les doublons
        data["variant_created"] = True

        # Créer la variante
        try:
            product = await db.create_product(
                merchant_id=data["merchant_id"],
                name=f"{data['name']} - {data['variant_name']}",
                price=data["price"],
                min_price=data["min_price"],
                description=data.get("description"),
                image_path=data.get("image_path"),
                group_id=data["group_id"],
                variant_name=data["variant_name"]
            )

            img_msg = "📷 Image enregistrée!\n" if data.get("image_path") else ""

            # Demander si le marchand veut ajouter une autre variante
            session["step"] = "ask_another_variant"
            session["data"]["last_variant_code"] = product['code']
            # Réinitialiser l'image pour la prochaine variante
            session["data"]["image_path"] = None

            return {
                "response": f"""✅ *Variante créée!*

📦 *{product['name']}*
🏷️ Code: *{product['code']}*
{img_msg}
🎨 Tu veux ajouter *une autre couleur/modèle*?

Réponds *oui* pour continuer
Réponds *non* pour terminer""",
                "action": "variant_created",
                "product_code": product['code']
            }
        except Exception as e:
            del product_sessions[merchant_phone]
            return {
                "response": f"Erreur lors de la création: {str(e)}",
                "action": "error"
            }

    # Étape: Demander si autre variante
    if step == "ask_another_variant":
        msg_lower = message.lower().strip()

        if msg_lower in ['oui', 'yes', 'o', 'y', 'ok', 'ouais', '1']:
            # Continuer avec une nouvelle variante
            session["step"] = "variant_name"
            # Réinitialiser les flags pour la nouvelle variante
            data["variant_created"] = False
            data["image_path"] = None
            return {
                "response": f"📦 *Ajout d'une autre variante pour {data['name']}*\n\nQuel est le *nom de cette variante*?\n(ex: Noir, Rose, Taille M, etc.)",
                "action": "variant_continue"
            }

        elif msg_lower in ['non', 'no', 'n', 'nope', 'nan', '0', 'stop', 'fini', 'terminer']:
            original_code = data.get("original_code")
            del product_sessions[merchant_phone]

            return {
                "response": f"""✅ *Toutes les variantes ont été ajoutées!*

👉 Ajoute *{original_code}* dans ton Status WhatsApp.
Les clients pourront demander les autres couleurs!

💡 Pour ajouter des variantes plus tard:
Écris *variante {original_code}*""",
                "action": "variants_complete"
            }

        else:
            return {
                "response": "Réponds *oui* pour ajouter une autre variante\nOu *non* pour terminer",
                "action": "ask_again"
            }

    # === ÉTAPES POUR NOUVEAU PRODUIT ===

    # Étape 1: Nom du produit
    if step == "name":
        data["name"] = message.strip()
        session["step"] = "price"
        return {
            "response": f"✅ Nom: *{data['name']}*\n\nÉtape 2/5: Quel est le *prix de vente*? (en FCFA)\n\nExemple: 15000 ou 15k",
            "action": "product_step"
        }

    # Étape 2: Prix
    if step == "price":
        price = extract_price(message)
        if not price or price < 100:
            return {
                "response": "Prix invalide. Entre un montant valide.\n\nExemple: 15000 ou 15k",
                "action": "error"
            }
        data["price"] = price
        session["step"] = "min_price"
        return {
            "response": f"✅ Prix: *{price:,.0f} F*\n\nÉtape 3/5: Quel est le *prix minimum* que tu acceptes?\n\nExemple: 12000 ou 12k",
            "action": "product_step"
        }

    # Étape 3: Prix minimum
    if step == "min_price":
        min_price = extract_price(message)
        if not min_price or min_price < 100:
            return {
                "response": "Prix invalide. Entre un montant valide.\n\nExemple: 12000 ou 12k",
                "action": "error"
            }
        if min_price > data["price"]:
            return {
                "response": f"Le prix minimum doit être inférieur au prix de vente ({data['price']:,.0f} F).\n\nEntre un prix minimum:",
                "action": "error"
            }
        data["min_price"] = min_price
        session["step"] = "description"
        return {
            "response": f"✅ Prix minimum: *{min_price:,.0f} F*\n\nÉtape 4/5: Ajoute une *description* (ou écris *passer* pour ignorer)",
            "action": "product_step"
        }

    # Étape 4: Description
    if step == "description":
        if message.lower() not in ['passer', 'skip', 'non', '-']:
            data["description"] = message.strip()
        else:
            data["description"] = None

        session["step"] = "image"
        return {
            "response": "✅ Description enregistrée!\n\nÉtape 5/5: Envoie *UNE* photo du produit (ou écris *passer* si pas d'image)\n\n⚠️ Une seule image à la fois!",
            "action": "product_step"
        }

    # Étape 5: Image
    if step == "image":
        # Vérifier si le produit a déjà été créé (protection anti-doublon)
        if data.get("product_created"):
            print(f"[MerchantCommands] Produit déjà créé, message tardif ignoré")
            return {
                "response": "",
                "action": "ignored"
            }

        # Si on a déjà une image dans data ET qu'une nouvelle image arrive,
        # ignorer SEULEMENT si le message est vide (image dupliquée WhatsApp)
        if data.get("image_path") and image_path and not message.strip():
            print(f"[MerchantCommands] Image déjà reçue, ignorant l'image supplémentaire")
            return {
                "response": "",
                "action": "ignored"  # Ne pas envoyer de message, ignorer silencieusement
            }

        if image_path:
            data["image_path"] = image_path
        elif message.lower() not in ['passer', 'skip', 'non', '-']:
            # Le marchand a envoyé un texte au lieu d'une image
            return {
                "response": "Envoie une *photo* ou écris *passer* pour continuer sans image",
                "action": "error"
            }

        # Marquer que la création est en cours pour éviter les doublons
        data["product_created"] = True

        # Créer le produit
        try:
            product = await db.create_product(
                merchant_id=data["merchant_id"],
                name=data["name"],
                price=data["price"],
                min_price=data["min_price"],
                description=data.get("description"),
                image_path=data.get("image_path")
            )

            img_msg = "📷 Image enregistrée!\n" if data.get("image_path") else ""

            # Passer à l'étape optionnelle d'ajout de variantes
            session["step"] = "ask_variant"
            session["data"]["product_code"] = product['code']
            session["data"]["product_id"] = product['id']

            return {
                "response": f"""✅ *Produit créé!*

📦 *{product['name']}*
🏷️ Code: *{product['code']}*
💰 Prix: {product['price']:,.0f} F
{img_msg}
🎨 Tu as *d'autres couleurs/modèles* de ce produit?

Réponds *oui* pour ajouter une variante
Réponds *non* pour terminer""",
                "action": "product_created",
                "product_code": product['code']
            }
        except Exception as e:
            del product_sessions[merchant_phone]
            return {
                "response": f"Erreur lors de la création: {str(e)}",
                "action": "error"
            }

    # Étape optionnelle: Demander si variantes
    if step == "ask_variant":
        msg_lower = message.lower().strip()

        if msg_lower in ['oui', 'yes', 'o', 'y', 'ok', 'ouais', 'yes', '1']:
            # Le marchand veut ajouter une variante
            product_code = data.get("product_code")
            product = await db.get_product_by_code(product_code)

            if not product:
                del product_sessions[merchant_phone]
                return {"response": "Erreur: produit non trouvé.", "action": "error"}

            # Générer ou récupérer le group_id
            group_id = product.get('group_id')
            if not group_id:
                group_id = await db.generate_group_id()
                # Mettre à jour le produit original avec le group_id
                from ..database.connection import get_connection
                async with get_connection() as conn:
                    await conn.execute(
                        "UPDATE products SET group_id = ? WHERE id = ?",
                        (group_id, product['id'])
                    )
                    await conn.commit()

            # Mettre à jour la session pour la création de variante
            session["step"] = "variant_name"
            session["data"]["group_id"] = group_id
            session["data"]["original_code"] = product_code
            session["data"]["is_variant"] = True

            return {
                "response": f"📦 *Ajout d'une variante pour {data['name']}*\n\nQuel est le *nom de cette variante*?\n(ex: Rouge, Bleu, Taille XL, etc.)",
                "action": "variant_start"
            }

        elif msg_lower in ['non', 'no', 'n', 'nope', 'nan', '0', 'stop', 'fini', 'terminer']:
            # Le marchand ne veut pas de variante
            product_code = data.get("product_code")
            del product_sessions[merchant_phone]

            return {
                "response": f"""✅ *Parfait!*

👉 Ajoute *{product_code}* dans ton Status WhatsApp pour commencer à vendre!

💡 Pour ajouter des variantes plus tard:
Écris *variante {product_code}*""",
                "action": "product_complete"
            }

        else:
            # Réponse non comprise
            return {
                "response": "Réponds *oui* pour ajouter une autre couleur/modèle\nOu *non* pour terminer",
                "action": "ask_again"
            }

    return {"response": "Erreur inconnue.", "action": "error"}
