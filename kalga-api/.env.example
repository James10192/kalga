# ============================================
# KALGA API — Configuration
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================

DEBUG=true

# DeepSeek API (pour l'IA)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# WhatsApp Bridge
WHATSAPP_BRIDGE_URL=http://localhost:3001

# Expiration conversations (jours)
CONVERSATION_EXPIRY_DAYS=7

# === OBLIGATOIRE — le serveur refuse de démarrer sans ces valeurs ===

# Clé secrète JWT (min 32 caractères)
# Générez avec: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Mot de passe admin (min 8 caractères)
ADMIN_PASSWORD=

# Clé partagée API <-> Bridge WhatsApp (protège les routes du bridge)
INTERNAL_API_KEY=

# CORS — origines autorisées (format JSON array)
ALLOWED_ORIGINS=["http://localhost:8002","http://127.0.0.1:8002"]
